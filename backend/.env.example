# Salin file ini jadi .env  ->  cp .env.example .env
# File .env tidak ikut ke git (lihat .gitignore)

# Port server. Kalau diubah, ubah juga EXPO_PUBLIC_API_URL di mobile/.env
PORT=3000

# Kunci penandatanganan JWT. Untuk tugas kuliah boleh dibiarkan,
# tapi jangan dipakai kalau server diakses dari internet.
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang
JWT_EXPIRES_IN=7d

# MQTT broker
MQTT_URL=mqtt://broker.emqx.io:1883
MQTT_TOPIC_PREFIX=kelompok3

# Perangkat utama
DEVICE_ID=smartfarm-01
DEVICE_NAME=Smart Farm 01

# Lokasi file database SQLite (relatif terhadap folder backend/)
DB_PATH=data/smartfarm.db

# Akun demo, dibuat otomatis saat server pertama kali dijalankan
DEMO_NAME=Petani Demo
DEMO_EMAIL=petani@smartfarm.id
DEMO_PASSWORD=password123
