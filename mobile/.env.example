# Salin jadi .env  ->  cp .env.example .env

# Alamat backend.
#
# BIARKAN DIKOMENTARI saat pengembangan. Aplikasi menemukan sendiri alamat
# laptop dari Expo, jadi IP yang berubah-ubah karena pindah WiFi atau DHCP
# tidak lagi menjadi masalah.
#
# Isi hanya kalau backend berjalan di komputer lain, atau saat build APK —
# APK tidak punya Metro untuk ditanyai, jadi alamatnya harus ditulis.
#
# EXPO_PUBLIC_API_URL=http://192.168.1.5:3000

# Perangkat yang ditampilkan aplikasi. Harus sama dengan DEVICE_ID di backend.
EXPO_PUBLIC_DEVICE_ID=smartfarm-01
